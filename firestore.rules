rules_version = '2';
// Spark admin, staff and investor access. Products contain public display fields only.
// Sales/expenses are manual records: description/string, amount/number,
// date/YYYY-MM-DD string, createdAt/timestamp. They never change inventory.
// Settings are private owner configuration. All other paths default-deny.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() {
      return request.auth != null && request.auth.uid == 'sCkXSrVIlHNGBoufFtirvLBvaTi1';
    }
    // Only the fixed owner can provision access; legacy /users roles grant nothing.
    function assignedRole(role) {
      return request.auth != null
        && exists(/databases/$(database)/documents/access/$(request.auth.uid))
        && get(/databases/$(database)/documents/access/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/access/$(request.auth.uid)).data.role == role;
    }
    function staff() { return assignedRole('staff'); }
    function investor(uid) { return request.auth != null && request.auth.uid == uid && assignedRole('investor'); }
    function validAccess(uid) {
      let d = request.resource.data;
      return uid != 'sCkXSrVIlHNGBoufFtirvLBvaTi1'
        && d.keys().hasAll(['role','active','label','updatedAt'])
        && d.keys().hasOnly(['role','active','label','updatedAt'])
        && d.role in ['staff','investor'] && d.active is bool
        && d.label is string && d.label.size() > 0 && d.label.size() <= 100
        && d.updatedAt == request.time;
    }
    function validInvestorProduct(uid, productId) {
      let d = request.resource.data;
      return d.keys().hasAll(['productId','name','image','agreedPrice','reference','updatedAt'])
        && d.keys().hasOnly(['productId','name','image','agreedPrice','reference','updatedAt'])
        && d.productId == productId && d.productId is string
        && d.name is string && d.name.size() > 0 && d.name.size() <= 300
        && d.image is string && d.image.size() <= 2000
        && d.agreedPrice is number && d.agreedPrice >= 0 && d.agreedPrice <= 1000000000
        && d.reference is string && d.reference.size() > 0 && d.reference.size() <= 500
        && d.updatedAt == request.time
        && exists(/databases/$(database)/documents/products/$(productId))
        && get(/databases/$(database)/documents/access/$(uid)).data.role == 'investor';
    }
    // Public variants contain display/stock fields only; never investor agreements.
    // Optional price/stock may be null until the merchant confirms them.
    function validSizes(s) {
      // Round-trip rejects numbers, maps and nested arrays without unrolling.
      // The separator is reserved and cannot occur inside a selling-unit label.
      return s.size() <= 40 && (s == [] || s == s.join('~').split('~'));
    }
    function validVariant(v) {
      let price = v.price;
      let stock = v.stockOnHand;
      return v.keys().hasOnly(['id','color','image','price','stockOnHand','sizes'])
        && v.get('id', '') is string
        && v.color is string
        && v.image is string
        && (price == null || (price is number && price >= 0))
        && (stock == null || (stock is int && stock >= 0))
        && validSizes(v.sizes);
    }
    function validVariants(v) {
      return v is list && v.size() <= 8
        && (v.size() <= 0 || validVariant(v[0]))
        && (v.size() <= 1 || validVariant(v[1]))
        && (v.size() <= 2 || validVariant(v[2]))
        && (v.size() <= 3 || validVariant(v[3]))
        && (v.size() <= 4 || validVariant(v[4]))
        && (v.size() <= 5 || validVariant(v[5]))
        && (v.size() <= 6 || validVariant(v[6]))
        && (v.size() <= 7 || validVariant(v[7]))
      ;
    }
    // Separate public display profiles keep variant validation below rule limits.
    function validFabricProfile(p) {
      return p.keys().hasOnly(['composition','weight','feel','breathability','care','uses','videoUrl','occasions'])
        && p.get('composition','') is string && p.get('composition','').size() <= 400
        && p.get('weight','') is string && p.get('weight','').size() <= 400
        && p.get('feel','') is string && p.get('feel','').size() <= 400
        && p.get('breathability','') is string && p.get('breathability','').size() <= 400
        && p.get('care','') is string && p.get('care','').size() <= 400
        && p.get('uses','') is string && p.get('uses','').size() <= 400
        && p.get('videoUrl','') is string && p.get('videoUrl','').size() <= 2000
        && p.get('occasions',[]) is list && p.get('occasions',[]).size() <= 5
        && p.get('occasions',[]).hasOnly(['wedding','work','festive','graduation','everyday']);
    }
    function cleanPublicProduct() {
      // Public product documents must contain only known display/inventory
      // fields. A new cost/margin field is denied automatically.
      return request.resource.data.keys().hasOnly([
        'badge', 'category', 'color', 'colour', 'deliveryEstimate', 'description', 'ethnicStyle', 'fabric', 'fabricType', 'featured', 'id', 'image', 'image1',
        'image2', 'image3', 'image4', 'image5', 'image6', 'image7', 'image8', 'imageSource', 'images', 'instagramVideoUrl', 'materialProductId', 'measurementRequired', 'name',
        'originInfluence', 'price', 'productName', 'productType', 'quantity', 'salePrice', 'size', 'sizes', 'sku', 'status', 'stockOnHand', 'tags', 'videoUrl', 'createdAt', 'updatedAt', 'variants', 'storeSection'
      ])
      && request.resource.data.status in ['Published','Draft','Out of Stock']
      && (request.resource.data.price == null ||
          (request.resource.data.price is number && request.resource.data.price >= 0))
      && (!('variants' in request.resource.data) || validVariants(request.resource.data.variants))

      && (
        !request.resource.data.keys().hasAny(['stockOnHand']) ||
        (request.resource.data.stockOnHand == null || (request.resource.data.stockOnHand is int
         && request.resource.data.stockOnHand >= 0))
      );
    }


    function validRecord() {
      let d = request.resource.data;
      return d.keys().hasAll(['description','amount','date','createdAt','createdBy'])
        && d.keys().hasOnly(['description','amount','date','createdAt','createdBy'])
        && d.description is string && d.description.size() > 0 && d.description.size() <= 1000
        && d.amount is number && d.amount > 0 && d.amount <= 1000000000
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.createdAt == request.time && d.createdBy == request.auth.uid;
    }
    function validSettings() {
      let d = request.resource.data;
      return d.keys().hasOnly(['whatsappNumber','pickupAddress','bankName','accountName',
        'accountNumber','instagramUrl','googleDriveUploadUrl','googleDriveUploadToken','updatedAt'])
        && d.updatedAt == request.time;
    }
    match /products/{id} {
      allow read: if owner() || resource.data.status in ['Published','Out of Stock'];
      allow create, update: if owner() && cleanPublicProduct();
      allow delete: if false;
    }
    match /fabricProfiles/{productId} {
      allow read: if owner() || get(/databases/$(database)/documents/products/$(productId)).data.status in ['Published','Out of Stock'];
      allow create, update: if owner() && validFabricProfile(request.resource.data)
        && existsAfter(/databases/$(database)/documents/products/$(productId));
      allow delete: if false;
    }
    match /settings/{id} {
      allow read: if owner();
      allow create, update: if owner() && validSettings();
      allow delete: if false;
    }
    match /sales/{id} {
      allow read: if owner() || (staff() && resource.data.createdBy == request.auth.uid);
      allow create: if (owner() || staff()) && validRecord();
      allow update, delete: if false;
    }
    // Legacy expenses are read-only; new expenses require approval.
    match /expenses/{id} {
      allow read: if owner();
      allow create, update, delete: if false;
    }
    function validExpenseSubmission() {
      let d = request.resource.data;
      return d.keys().hasAll(['description','amount','date','createdAt','createdBy','status'])
        && d.keys().hasOnly(['description','amount','date','createdAt','createdBy','status'])
        && d.description is string && d.description.size() > 0 && d.description.size() <= 1000
        && d.amount is number && d.amount > 0 && d.amount <= 1000000000
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}
    match /access/{uid} {
      allow get: if owner() || (request.auth != null && request.auth.uid == uid);
      allow list: if owner();
      allow create, update: if owner() && validAccess(uid);
      allow delete: if false;
    }
    match /investorCatalog/{uid}/items/{productId} {
      allow read: if owner() || investor(uid);
      allow create, update: if owner() && validInvestorProduct(uid, productId);
      allow delete: if owner();
    }
    // Private investor ledger. Only owner records movements; investors read their own.
    function validLedger() {
      let d = request.resource.data;
      return d.keys().hasAll(['received','sold','grossSales','investorEarnings','updatedAt'])
        && d.keys().hasOnly(['received','sold','grossSales','investorEarnings','updatedAt'])
        && d.received is int && d.received >= 0 && d.received <= 1000000000
        && d.sold is int && d.sold >= 0 && d.sold <= d.received
        && d.grossSales is number && d.grossSales >= 0 && d.grossSales <= 1000000000000
        && d.investorEarnings is number && d.investorEarnings >= 0 && d.investorEarnings <= 1000000000000
        && d.updatedAt == request.time;
    }
    function validMovement() {
      let d = request.resource.data;
      return d.keys().hasAll(['kind','quantity','productId','unitRetailPrice','agreedUnitAmount','grossAmount','investorAmount','reference','createdAt','createdBy'])
        && d.keys().hasOnly(['kind','quantity','productId','unitRetailPrice','agreedUnitAmount','grossAmount','investorAmount','reference','createdAt','createdBy'])
        && d.kind in ['receipt','sale']
        && d.quantity is int && d.quantity > 0 && d.quantity <= 1000000
        && d.productId is string && d.productId.size() > 0 && d.productId.size() <= 200
        && d.unitRetailPrice is number && d.unitRetailPrice >= 0 && d.unitRetailPrice <= 1000000000
        && d.agreedUnitAmount is number && d.agreedUnitAmount >= 0 && d.agreedUnitAmount <= 1000000000
        && d.grossAmount is number && d.grossAmount >= 0 && d.grossAmount <= 1000000000000
        && d.investorAmount is number && d.investorAmount >= 0 && d.investorAmount <= 1000000000000
        && d.reference is string && d.reference.size() > 0 && d.reference.size() <= 300
        && d.createdAt == request.time && d.createdBy == request.auth.uid;
    }
    match /investorLedger/{uid}/products/{productId} {
      allow get, list: if owner() || investor(uid);
      allow create, update: if owner() && validLedger()
        && exists(/databases/$(database)/documents/investorCatalog/$(uid)/items/$(productId));
      allow delete: if false;
      match /movements/{movementId} {
        allow get, list: if owner() || investor(uid);
        allow create: if owner() && validMovement() && request.resource.data.productId == productId;
        allow update, delete: if false;
      }
    }
    match /orders/{id} {
      allow read: if owner();
      allow write: if false;
    }
  }
}
)
        && d.createdAt == request.time && d.createdBy == request.auth.uid
        && d.status == 'pending';
    }
    match /expenseRequests/{id} {
      allow get, list: if owner() || (staff() && resource.data.createdBy == request.auth.uid);
      allow create: if (owner() || staff()) && validExpenseSubmission();
      allow update: if owner()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy'])
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if false;
    }
    function validRestockRequest() {
      let d = request.resource.data;
      return d.keys().hasAll(['productId','productName','note','createdAt','createdBy','status'])
        && d.keys().hasOnly(['productId','productName','note','createdAt','createdBy','status'])
        && d.productId is string && d.productId.size() > 0 && d.productId.size() <= 200
        && exists(/databases/$(database)/documents/products/$(d.productId))
        && d.productName is string && d.productName.size() > 0 && d.productName.size() <= 300
        && d.note is string && d.note.size() > 0 && d.note.size() <= 500
        && d.createdAt == request.time && d.createdBy == request.auth.uid && d.status == 'pending';
    }
    match /restockRequests/{id} {
      allow get, list: if owner() || (staff() && resource.data.createdBy == request.auth.uid);
      allow create: if staff() && validRestockRequest();
      allow update: if owner() && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy'])
        && request.resource.data.status in ['resolved','dismissed']
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if false;
    }
    match /access/{uid} {
      allow get: if owner() || (request.auth != null && request.auth.uid == uid);
      allow list: if owner();
      allow create, update: if owner() && validAccess(uid);
      allow delete: if false;
    }
    match /investorCatalog/{uid}/items/{productId} {
      allow read: if owner() || investor(uid);
      allow create, update: if owner() && validInvestorProduct(uid, productId);
      allow delete: if owner();
    }
    // Private investor ledger. Only owner records movements; investors read their own.
    function validLedger() {
      let d = request.resource.data;
      return d.keys().hasAll(['received','sold','grossSales','investorEarnings','updatedAt'])
        && d.keys().hasOnly(['received','sold','grossSales','investorEarnings','updatedAt'])
        && d.received is int && d.received >= 0 && d.received <= 1000000000
        && d.sold is int && d.sold >= 0 && d.sold <= d.received
        && d.grossSales is number && d.grossSales >= 0 && d.grossSales <= 1000000000000
        && d.investorEarnings is number && d.investorEarnings >= 0 && d.investorEarnings <= 1000000000000
        && d.updatedAt == request.time;
    }
    function validMovement() {
      let d = request.resource.data;
      return d.keys().hasAll(['kind','quantity','productId','unitRetailPrice','agreedUnitAmount','grossAmount','investorAmount','reference','createdAt','createdBy'])
        && d.keys().hasOnly(['kind','quantity','productId','unitRetailPrice','agreedUnitAmount','grossAmount','investorAmount','reference','createdAt','createdBy'])
        && d.kind in ['receipt','sale']
        && d.quantity is int && d.quantity > 0 && d.quantity <= 1000000
        && d.productId is string && d.productId.size() > 0 && d.productId.size() <= 200
        && d.unitRetailPrice is number && d.unitRetailPrice >= 0 && d.unitRetailPrice <= 1000000000
        && d.agreedUnitAmount is number && d.agreedUnitAmount >= 0 && d.agreedUnitAmount <= 1000000000
        && d.grossAmount is number && d.grossAmount >= 0 && d.grossAmount <= 1000000000000
        && d.investorAmount is number && d.investorAmount >= 0 && d.investorAmount <= 1000000000000
        && d.reference is string && d.reference.size() > 0 && d.reference.size() <= 300
        && d.createdAt == request.time && d.createdBy == request.auth.uid;
    }
    match /investorLedger/{uid}/products/{productId} {
      allow get, list: if owner() || investor(uid);
      allow create, update: if owner() && validLedger()
        && exists(/databases/$(database)/documents/investorCatalog/$(uid)/items/$(productId));
      allow delete: if false;
      match /movements/{movementId} {
        allow get, list: if owner() || investor(uid);
        allow create: if owner() && validMovement() && request.resource.data.productId == productId;
        allow update, delete: if false;
      }
    }
    match /orders/{id} {
      allow read: if owner();
      allow write: if false;
    }
  }
}
