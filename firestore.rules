rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function accountPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function active() {
      return signedIn() && exists(accountPath())
        && get(accountPath()).data.active == true;
    }
    function role() {
      return get(accountPath()).data.role;
    }
    function superAdmin() { return active() && role() == 'super_admin'; }
    function staff() { return active() && role() == 'staff'; }
    function operations() { return superAdmin() || staff(); }
    function investorOwner(ownerUid) {
      return active() && role() == 'investor'
        && request.auth.uid == ownerUid
        && get(accountPath()).data.investorId == ownerUid;
    }
    function cleanPublicProduct() {
      // Public product documents must contain only known display/inventory
      // fields. A new cost/margin field is denied automatically.
      return request.resource.data.keys().hasOnly([
        'badge', 'category', 'color', 'colour', 'deliveryEstimate', 'description', 'ethnicStyle', 'fabric', 'fabricType', 'featured', 'id', 'image', 'image1',
        'image2', 'image3', 'image4', 'image5', 'image6', 'image7', 'image8', 'imageSource', 'images', 'instagramVideoUrl', 'materialProductId', 'measurementRequired', 'name',
        'originInfluence', 'price', 'productName', 'productType', 'quantity', 'salePrice', 'size', 'sizes', 'sku', 'status', 'stockOnHand', 'tags', 'videoUrl', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.status in ['Published','Draft','Out of Stock']
      && request.resource.data.price is number
      && request.resource.data.price >= 0
      && !request.resource.data.keys().hasAny([
        'investorId', 'investorUid', 'investorPayout', 'payoutPerUnit',
        'agreedPayout', 'costPrice', 'supplierCost', 'grossMargin',
        'margin', 'profit', 'investorAgreement',
        'wholesalePrice', 'purchasePrice', 'supplierPrice',
        'unitCost', 'cost', 'internalCost', 'investorRate',
        'investorPayoutPerUnit', 'investorEmail',
        'investorAgreementId', 'settlementBankAccount'
      ])
      && (
        !request.resource.data.keys().hasAny(['stockOnHand']) ||
        (request.resource.data.stockOnHand is int
         && request.resource.data.stockOnHand >= 0)
      );
    }

    match /users/{uid} {
      allow get: if (active() && request.auth.uid == uid) || superAdmin();
      allow list: if superAdmin();
      // Only privileged server functions / Admin SDK manage identities.
      allow create, update, delete: if false;
    }

    match /products/{id} {
      // Only published stock is public. Staff and Super Admin can see the
      // operational product catalog; drafts are never readable anonymously.
      allow read: if operations()
        || resource.data.status in ['Published', 'Out of Stock'];
      allow create, update: if superAdmin() && cleanPublicProduct();
      allow delete: if superAdmin();
    }

    // Store settings can contain credentials, bank details, upload tokens.
    match /settings/{id} {
      allow read, write: if superAdmin();
    }

    match /orders/{id} {
      allow read: if operations();
      allow write: if false;
    }

    // Actual retail transactions; not readable by investors.
    match /sales/{id} {
      allow read: if operations();
      allow write: if false;
    }

    match /expenses/{id} {
      allow read, write: if superAdmin();
    }

    // Cost, payout agreement and margin never belong in public /products.
    match /investorAgreements/{productId} {
      allow read: if superAdmin();
      allow write: if false;
    }
    match /financeSales/{saleId} {
      allow read: if superAdmin();
      allow write: if false;
    }

    // Server-published investor projections contain only agreed entitlement.
    match /investorCatalog/{investorUid}/items/{productId} {
      allow read: if superAdmin() || investorOwner(investorUid);
      allow write: if false;
    }
    match /investorSales/{investorUid}/entries/{saleId} {
      allow read: if superAdmin() || investorOwner(investorUid);
      allow write: if false;
    }
    // An investor can inspect immutable amendments to their own agreed terms.
    match /investorCatalog/{investorUid}/history/{amendmentId} {
      allow read: if superAdmin() || investorOwner(investorUid);
      allow write: if false;
    }

    match /auditEvents/{eventId} {
      allow read: if superAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
